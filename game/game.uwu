;macro SPC_CHR_DATA $1F00
;macro SPC_SPRITE_DATA $1F02
macro SPC_FORCE_RENDER $1FF0
macro SPC_BACKGROUND_ADDR $1FFC
macro SPC_SPRITE_COUNT $1FFE
macro CONTROLLER $1FFF


macro BT_UP $40
macro BT_DOWN $20
macro BT_LEFT $10
macro BT_RIGHT $08
macro BT_A $04
macro BT_B $02
macro BT_START $01
macro BACKGROUND_TILE_COUNT %32


macro tmp $0000

macro robot_x $0002;	address
macro robot_y $0003;	address
macro pointer_x $0004;	address
macro pointer_y $0005;	address
macro MAX_X $07;		value, inclusive
;macro MAX_X $04;		value
macro MAX_Y $03;		value, inclusive
;macro MAX_Y $02;		value

macro current_level $0006;
macro robot_direction $0007;
macro robot_current_tile $0008;

macro background_ram $0100;	address
macro bg_default $0c;

macro sprite_count $2;

;macro sprite_pointer $1000;
macro sprite_pointer $1F80
;macro sprite_pointer $0008;
macro texture_pointer $00;
macro palette_pointer $00;
;macro sprite_robot $1004;

macro sprite_robot $1F84;
macro texture_robot $07
macro palette_robot $00


.init
;ldd pointer_x;
;ldx 3;
;write;

call @loadbackground
call @loadlevel
call @mainloop


