;;;;;;;;;;;;;;;
; MOVE CURSOR ;
;;;;;;;;;;;;;;;
.movecursor

; -- UP --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_UP;
and;			controller&button up
;not;			invert for leap
leap %13;			3+1+2+1+1+1+1 = 10
ldd pointer_y;
read;
dupeXY;
swapXA;
leap %3;	if y is already 0, dont decrease
swapXY;
swapXA;
dec;
swapXA;
write;

; -- LEFT --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_LEFT;
and;			controller&button left
;not;			invert for leap
leap %13;			3+1+2+1+1+1+1 = 10
ldd pointer_x;
read;
dupeXY;
swapXA;
leap %3;	if x is already 0, dont decrease
swapXY;
swapXA;
dec;
swapXA;
write;

; -- DOWN --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_DOWN;
and;			controller&button down
;not;			invert for leap
leap %16;			3+1+2+1+2+1+1+1 = 12
ldd pointer_y;
read;
dupeXY;
swapXA;
ldx MAX_Y;
sub;
leap %3;	if y is already MAX_Y, dont increase
swapXY;
swapXA;
inc;
swapXA;
write;

; -- RIGHT --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_RIGHT;
and;			controller&button down
;not;			invert for leap
leap %16;			3+1+2+1+2+1+1+1 = 12
ldd pointer_x;
read;
dupeXY;
swapXA;
ldx MAX_X;
sub;
leap %3;	if x is already MAX_X, dont increase
swapXY;
swapXA;
inc;
swapXA;
write;


ret;


;;;;;;;;;;;;;;;;;;
; LOADSPRITEDATA ;
;;;;;;;;;;;;;;;;;;
.loadspritedata

; -- load x and y position in X and Y registers --
ldd pointer_x
read;
swapXY;
ldd pointer_y;
read;
ldd sprite_pointer;
swapXY;

; -- convert to format (<<3)
swapXA;
ldx $08;
mul;
swapXA;

swapXY;

swapXA;
ldx $08;
mul;
swapXA;

swapXY;

; -- write it to sprite_pointer (x, y)
write;
incd;
swapXY;
write;

; -- write texture and palette
incd;
ldx texture_pointer;
write;
incd;
ldx palette_pointer;
write;


; -- tell ppu how many sprites there are
ldx sprite_count;
ldd SPC_SPRITE_COUNT;
write;

ret;





;;;;;;;;;;;;
; MAINLOOP ;
;;;;;;;;;;;;
.mainloop
pop;
pop;	because i use CALL it pushes 2 bytes on stack, so this undoes that

call @movecursor
call @loadspritedata

ldd SPC_FORCE_RENDER;
read;

call @mainloop




