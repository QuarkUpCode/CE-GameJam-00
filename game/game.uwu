;macro SPC_CHR_DATA $1F00
;macro SPC_SPRITE_DATA $1F02
macro SPC_FORCE_RENDER $1FF0
macro SPC_SPRITE_COUNT $1FFE
macro CONTROLLER $1FFF


macro BT_UP $40
macro BT_DOWN $20
macro BT_LEFT $10
macro BT_RIGHT $08
macro BT_A $04
macro BT_B $02
macro BT_START $01


macro tmp $0000

macro robot_x $0002;	address
macro robot_y $0003;	address
macro pointer_x $0004;	address
macro pointer_y $0005;	address
macro MAX_X $07;		value
macro MAX_Y $03;		value

macro sprite_count $2;

;macro sprite_pointer $1000;
macro sprite_pointer $1F80
;macro sprite_pointer $0008;
macro texture_pointer $00;
macro palette_pointer $00;
macro sprite_robot $1004;


.init
call @mainloop


;.loadgraphics
;; load graphics data routine
;
;ldd #graphics;	<- for my compiler, you can just remember the indice and the length into which to replace later when you'll know where #graphics is
;save tmp;	<- here d is used exclusively as a 14-bit register
;ldd tmp;
;read;	fetch first byte (least significant)
;ldd CHR_DATA;
