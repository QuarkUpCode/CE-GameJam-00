;;;;;;;;;;;;;;;;;;;;
; RESET BACKGROUND ;
;;;;;;;;;;;;;;;;;;;;
.resetbackground

; -- setting A to WIDTH*HEIGHT --
;ldx MAX_X;
;swapXA;
;ldx MAX_Y;
;mul;
;ldx $0;
;swapxa;

ldx BACKGROUND_TILE_COUNT
swapxa;

ldd background_ram;
save tmp;
;ldx bg_default;
call @loop_resetbackground;		!!! THIS DOES NOT WORK BC CALL MODIFIES D, SO WHEN I DO INCD AND WRITE IT FUCKS UP <- update i used save and restore lol like that's litteraly why i implemented that
.loop_resetbackground
pop;	carefull, this fucks up x i think
pop;
leap %14;

restore tmp;
ldx bg_default;
write;
incd;
save tmp;

dec;
call @loop_resetbackground;

restore tmp;
decd;
ldx $04;
write;
ldd background_ram;
ldx $05;
write;

ret;


;;;;;;;;;;;;;;;;;;;
; LOAD BACKGROUND ;
;;;;;;;;;;;;;;;;;;;
.loadbackground

call @resetbackground
ldd background_ram;
save SPC_BACKGROUND_ADDR;

ret;



;;;;;;;;;;;;;;
;;;;;;;;;;;;;;
;;  LEVELS  ;;
;;;;;;;;;;;;;;
;;;;;;;;;;;;;;
.loadlevel_0

ldx $00;
ldd robot_x;
write;
ldd robot_y;
write;
ldd robot_direction;
write;

ldx $08;
ldd background_ram;
;could also like save to tmp then ldd tmp, swapxa, ldx %5, add, swapxa, write, restore tmp
incd;
incd;
incd;
incd;
write;
incd;
incd;
write;
incd;
incd;
write;
incd;
incd;
incd;
incd;
incd;
write;
incd;
incd;
incd;
write;
incd;
incd;
incd;
incd;
write;
incd;
incd;
incd;
incd;
write;
incd;
incd;
incd;
incd;
incd;
write;
incd;
write
incd;

ret;


.loadlevel_1



;;;;;;;;;;;;;;
; LOAD LEVEL ;
;;;;;;;;;;;;;;
.loadlevel

call @loadspritedata
call @resetbackground;

ldx current_level;
swapxa;
ldx %0;
sub;
leap 4;
call @loadlevel_0
ret;

ldx current_level;
swapxa;
ldx %1;
sub;
leap %4;
call @loadlevel_1
ret;


ret;





;;;;;;;;;;;;;;;
; ROTATE TILE ;
;;;;;;;;;;;;;;;
.rotatetile

; -- background tile index the pointer is pointing at (i really should rename it "cursor" instead cos eh)
ldx MAX_X;
swapXA;
inc;
ldd pointer_y;
read;
mul;
ldd pointer_x;
read;
add;
;dec;

ldd background_ram;
save tmp;
call @loop_rotatetile;
.loop_rotatetile
pop;
pop;
leap %11;
restore tmp;
incd;
save tmp;

dec;
call @loop_rotatetile;

restore tmp;
read;
swapxa;
ldx $0c; 0b1110
and;
ldx $08; 0b1000
sub;
leap %1;
ret;

restore tmp;
read;
swapxa;
inc;
ldx $02;
mod;
ldx $08;
add;
swapxa;
write;

ret;



;;;;;;;;;;;;;;;;;;;;;;;;;
; UTIL FETCH ROBOT TILE ;
;;;;;;;;;;;;;;;;;;;;;;;;;
.utilfetchrobottile

; -- background tile index the pointer is pointing at (i really should rename it "cursor" instead cos eh)
ldx MAX_X;
swapXA;
inc;
ldd robot_y;
read;
mul;
ldd robot_x;
read;
add;
;dec;

ldd background_ram;
save tmp;
call @loop_robottile;
.loop_robottile
pop;
pop;
leap %11;
restore tmp;
incd;
save tmp;

dec;
call @loop_robottile;

restore tmp;
read;
ldd robot_current_tile;
write;
ret;


;;;;;;;;;;;;;;;;;;;;;
; UTIL ROTATE ROBOT ;
;;;;;;;;;;;;;;;;;;;;;
.utilrotaterobot

call @utilfetchrobottile;

ldd robot_current_tile;
read;
swapxa;
ldx $0e;	0b1110
and;
ldx $08;	0b1000
sub;
not;
leap %1;
ret;


ldd robot_current_tile;
read;
swapXA;
ldx $01;
and;
; case tile != 0
leap %11;
ldx $03;
swapxa;
ldd robot_direction;
read;
sub; newdir = 3 - olddir
swapxa;
write;
ret;

;case tile ==0
ldd robot_direction;
read;
swapxa;
ldx $01;
xor;		//00 -> 01, 01-> 00, 10->11, 11->10
write
ret;


;;;;;;;;;;;;;;;;;
; EXECUTE ROBOT ;
;;;;;;;;;;;;;;;;;
.aexecuterobot

call @utilrotaterobot
ldd robot_direction;
read;
swapxa;
not
leap %9;
ldd robot_y;
read;
swapxa;
inc;
swapxa;
write;
ret;

ldd robot_x;
read;
swapxa;
inc;
swapxa;
write;
ret;

ret;








;;;;;;;;;;;;;;;;;
; NOT EXECUTE ROBOT ;
;;;;;;;;;;;;;;;;;
.executerobot
;call @utilfetchrobottile;

call @utilrotaterobot;

ldd robot_direction;
read;
dupexy;

swapxy;
dupexy;
swapxa;
ldx $00;
sub;
not;
; -- if direction == 0 DOWN
leap %27; {

ldd robot_y;
read;
swapxa;
ldx MAX_Y;
sub;
; if y != max_Y
leap %10;	{
ldd robot_y
read;
swapxa;
inc;
swapxa;
write;
leap %7;	}
call @loadlevel
call @mainloop
ret; }


swapxy;
dupexy;
swapxa;
ldx $01;
sub;
not;
; -- if direction == 1 RIGHT
leap %27; {

ldd robot_x;
read;
swapxa;
ldx MAX_X;
sub;
; if x != max_X
leap %10;	{
ldd robot_x
read;
swapxa;
inc;
swapxa;
write;
leap %7;	}
call @loadlevel
call @mainloop
ret; }


swapxy;
dupexy;
swapxa;
ldx $02;
sub;
not;
; -- if direction == 2 UP
leap %19; {

ldd robot_y;
read;
swapxa;
; -- if y != 0
leap %5; {
dec;
swapxa;
write;
leap %7; }{
call @loadlevel;
call @mainloop
ret; }


swapxy;
dupexy;
swapxa;
ldx $03;
sub;
not;
; -- if direction == 3 LEFT
leap %19; {

ldd robot_x;
read;
swapxa;
; -- if x != 0
leap %5; {
dec;
swapxa;
write;
leap %7; }{
call @loadlevel;
call @mainloop;
ret; }

ret;






;;;;;;;;;;;;;;;
; MOVE CURSOR ;
;;;;;;;;;;;;;;;
.movecursor

; -- UP --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_UP;
and;			controller&button up
;not;			invert for leap
leap %13;			3+1+2+1+1+1+1 = 10
ldd pointer_y;
read;
dupeXY;
swapXA;
leap %5;	if y is already 0, dont decrease
swapXY;
swapXA;
dec;
swapXA;
write;

; -- LEFT --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_LEFT;
and;			controller&button left
;not;			invert for leap
leap %13;			3+1+2+1+1+1+1 = 10
ldd pointer_x;
read;
dupeXY;
swapXA;
leap %5;	if x is already 0, dont decrease
swapXY;
swapXA;
dec;
swapXA;
write;

; -- DOWN --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_DOWN;
and;			controller&button down
;not;			invert for leap
leap %16;			3+1+2+1+2+1+1+1 = 12
ldd pointer_y;
read;
dupeXY;
swapXA;
ldx MAX_Y;
sub;
leap %5;	if y is already MAX_Y, dont increase
swapXY;
swapXA;
inc;
swapXA;
write;

; -- RIGHT --
ldd CONTROLLER;	read controller
read;
swapXA;
ldx BT_RIGHT;
and;			controller&button down
;not;			invert for leap
leap %16;			3+1+2+1+2+1+1+1 = 12
ldd pointer_x;
read;
dupeXY;
swapXA;
ldx MAX_X;
sub;
leap %5;	if x is already MAX_X, dont increase
swapXY;
swapXA;
inc;
swapXA;
write;



; -- A ==
ldd CONTROLLER;
read;
swapXA;
ldx BT_A;
and;
leap %3;
call @rotatetile;

; -- B ==
ldd CONTROLLER;
read;
swapXA;
ldx BT_B;
and;
leap %18;
call @loop_runrobot;
.loop_runrobot
pop;
pop;
call @executerobot
call @loadspritedata
ldd SPC_FORCE_RENDER;
read;
call @loop_runrobot
;leap %6;
;call @executerobot
;call @loadspritedata;

ret;


;;;;;;;;;;;;;;;;;;
; LOADSPRITEDATA ;
;;;;;;;;;;;;;;;;;;
.loadspritedata

;; --- POINTER ---
; -- load x and y position in X and Y registers --
ldd pointer_x
read;
swapXY;
ldd pointer_y;
read;
ldd sprite_pointer;
swapXY;

; -- convert to format (<<3)
swapXA;
ldx $08;
mul;
swapXA;

swapXY;

swapXA;
ldx $08;
mul;
swapXA;

swapXY;

; -- write it to sprite_pointer (x, y)
write;
incd;
swapXY;
write;

; -- write texture and palette
incd;
ldx texture_pointer;
write;
incd;
ldx palette_pointer;
write;



;; --- ROBOT ---
; -- load x and y position in X and Y registers --
ldd robot_x
read;
swapXY;
ldd robot_y;
read;
ldd sprite_robot;
swapXY;

; -- convert to format (<<3)
swapXA;
ldx $08;
mul;
swapXA;

swapXY;

swapXA;
ldx $08;
mul;
swapXA;

swapXY;

; -- write it to sprite_pointer (x, y)
write;
incd;
swapXY;
write;

; -- write texture and palette
incd;
ldx texture_robot;
write;
incd;
ldx palette_robot;
write;


; -- tell ppu how many sprites there are
ldx sprite_count;
ldd SPC_SPRITE_COUNT;
write;

ret;





;;;;;;;;;;;;
; MAINLOOP ;
;;;;;;;;;;;;
.mainloop
pop;
pop;	because i use CALL it pushes 2 bytes on stack, so this undoes that

call @movecursor
call @loadspritedata

ldd SPC_FORCE_RENDER;
read;

call @mainloop




